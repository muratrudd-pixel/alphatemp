<!DOCTYPE html>
<html lang="en" class="bg-slate-900">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AlphaTemp Command Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.plot.ly/plotly-2.35.0.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #0f172a;
            --bg-panel: #1e293b;
            --text-primary: #f1f5f9;
            --text-muted: #94a3b8;
            --blue-line: #3b82f6;
            --amber-obs: #f59e0b;
            --alpha-bg: rgba(6, 78, 59, 0.5);
            --overpriced-bg: rgba(127, 29, 29, 0.5);
        }
        body { font-family: 'Outfit', sans-serif; background: var(--bg-deep); color: var(--text-primary); }
        .mono { font-family: 'Space Mono', monospace; }
        .panel {
            background: var(--bg-panel);
            border: 1px solid rgba(148, 163, 184, 0.1);
            border-radius: 0.5rem;
        }
        .glow-dot {
            width: 6px; height: 6px; border-radius: 50%; background: #10b981;
            box-shadow: 0 0 6px #10b981;
            animation: pulse-glow 2s ease-in-out infinite;
        }
        @keyframes pulse-glow {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }
        select {
            background: var(--bg-panel);
            border: 1px solid rgba(148, 163, 184, 0.2);
            color: var(--text-primary);
            font-family: 'Space Mono', monospace;
            border-radius: 0.375rem;
            padding: 0.375rem 0.75rem;
            outline: none;
        }
        select:focus { border-color: var(--blue-line); }
        .signal-alpha { background: var(--alpha-bg); }
        .signal-alpha-gap { background: rgba(6, 95, 70, 0.6); border-left: 3px solid #10b981; }
        .signal-overpriced { background: var(--overpriced-bg); }
        .fade-in { animation: fadeIn 0.4s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
        @keyframes flash-new { 0% { background: rgba(245,158,11,0.3); } 100% { background: transparent; } }
        .flash-new { animation: flash-new 2s ease-out; }
        /* Plotly container sizing */
        .chart-container { width: 100%; min-height: 600px; }
        @media (max-width: 1023px) {
            .chart-container { min-height: 450px; }
        }
        @media (max-width: 639px) {
            .chart-container { min-height: 320px; }
        }
    </style>
</head>
<body class="min-h-screen">
    <!-- Header -->
    <header class="px-4 lg:px-6 py-3 flex flex-col sm:flex-row items-center justify-between gap-2 border-b border-slate-700/50">
        <div class="flex items-center gap-3">
            <div class="glow-dot"></div>
            <h1 class="text-lg lg:text-xl font-semibold tracking-tight">
                AlphaTemp <span class="text-slate-400 font-light">Command Center</span>
            </h1>
        </div>
        <div class="flex items-center gap-4">
            <span class="mono text-sm text-slate-300 font-semibold">NYC</span>
            <div id="date-toggle" class="flex text-sm mono">
                <button id="btn-today" class="px-3 py-1 rounded-l border border-slate-600 bg-blue-600 text-white">Today</button>
                <button id="btn-tomorrow" class="px-3 py-1 rounded-r border border-l-0 border-slate-600 bg-slate-700 text-slate-400 hover:bg-slate-600">Tomorrow</button>
            </div>
            <div id="clock" class="mono text-sm text-slate-400"></div>
            <span id="refresh-countdown" class="mono text-xs text-slate-500">60s</span>
            <span id="last-updated" class="mono text-xs text-slate-600"></span>
        </div>
    </header>

    <main class="p-4 lg:p-6 space-y-4 lg:space-y-5 max-w-[1600px] mx-auto">
        <!-- Chart + Feeds Row -->
        <div id="chart-feeds-row" class="grid grid-cols-1 lg:grid-cols-[1fr_520px] gap-4 lg:gap-5 lg:items-start">
            <!-- Chart (left) — natural height, no stretch -->
            <div class="panel p-4" id="chart-panel">
                <div class="flex items-center justify-between mb-3">
                    <h2 class="text-sm font-medium text-slate-300 uppercase tracking-widest">Forecast Ribbon</h2>
                    <div class="flex items-center gap-3">
                        <button id="btn-neighbors" class="px-2 py-0.5 text-[10px] mono rounded border border-slate-600 bg-slate-700 text-slate-400 hover:bg-slate-600 uppercase tracking-wider">Neighbors</button>
                        <span id="ribbon-model-run" class="mono text-xs text-slate-500"></span>
                    </div>
                </div>
                <div id="ribbon-chart" class="chart-container"></div>
            </div>

            <!-- Feeds (right) — JS-driven height to match chart panel -->
            <div id="feeds-col" class="flex flex-col gap-4 lg:gap-5" style="min-height:0;">
                <!-- Observation Feed -->
                <div class="panel p-3 flex flex-col flex-1" style="min-height:0;">
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-xs font-medium text-slate-300 uppercase tracking-widest">Observations</h2>
                        <span id="obs-status" class="mono text-[10px] text-slate-500"></span>
                    </div>
                    <div class="flex-1 overflow-y-auto" style="min-height:0;">
                        <table class="w-full">
                            <thead class="sticky top-0" style="background:var(--bg-panel);">
                                <tr class="border-b border-slate-700/50 text-left text-[10px] uppercase tracking-wider text-slate-400">
                                    <th class="pb-1.5 pr-2">Rcvd</th>
                                    <th class="pb-1.5 pr-2">Released</th>
                                    <th class="pb-1.5 pr-2">Obs</th>
                                    <th class="pb-1.5 pr-2">Source</th>
                                    <th class="pb-1.5 text-right">Temp</th>
                                </tr>
                            </thead>
                            <tbody id="obs-body" class="mono text-[11px]"></tbody>
                        </table>
                    </div>
                </div>
                <!-- Forecast Feed -->
                <div class="panel p-3 flex flex-col flex-1" style="min-height:0;">
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="text-xs font-medium text-slate-300 uppercase tracking-widest">HRRR Runs</h2>
                        <span id="fcst-status" class="mono text-[10px] text-slate-500"></span>
                    </div>
                    <div class="flex-1 overflow-y-auto" style="min-height:0;">
                        <table class="w-full">
                            <thead class="sticky top-0" style="background:var(--bg-panel);">
                                <tr class="border-b border-slate-700/50 text-left text-[10px] uppercase tracking-wider text-slate-400">
                                    <th class="pb-1.5 pr-2">Run</th>
                                    <th class="pb-1.5 pr-2">Rcvd</th>
                                    <th class="pb-1.5 pr-2">High At</th>
                                    <th class="pb-1.5 pr-2">&Delta; Time</th>
                                    <th class="pb-1.5 pr-2 text-right">High</th>
                                    <th class="pb-1.5 text-right">&Delta; Temp</th>
                                </tr>
                            </thead>
                            <tbody id="fcst-body" class="mono text-[11px]"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Market Intelligence -->
        <div class="panel p-4">
            <div class="flex items-center justify-between mb-3">
                <h2 class="text-sm font-medium text-slate-300 uppercase tracking-widest">Market Intelligence</h2>
                <span id="market-status" class="text-xs text-slate-500"></span>
            </div>
            <div id="market-table-wrap" class="overflow-x-auto">
                <p id="market-pending" class="text-sm text-slate-500 py-6 text-center">Market data pending</p>
                <table id="market-table" class="w-full text-sm hidden">
                    <thead>
                        <tr class="border-b border-slate-700/50 text-left text-xs uppercase tracking-wider text-slate-400">
                            <th class="pb-2 pr-4">Bracket</th>
                            <th class="pb-2 pr-4">Model Prob</th>
                            <th class="pb-2 pr-4">Market Mid</th>
                            <th class="pb-2 pr-4">Edge</th>
                            <th class="pb-2 pr-4">Bid</th>
                            <th class="pb-2">Ask</th>
                        </tr>
                    </thead>
                    <tbody id="market-body" class="mono text-xs"></tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
    // -----------------------------------------------------------------------
    // State
    // -----------------------------------------------------------------------
    let selectedCity = 'NYC';
    const PLOT_BG = '#1e293b';
    const GRID_COLOR = 'rgba(148,163,184,0.08)';
    const FONT_COLOR = '#94a3b8';

    // Convert UTC ISO string to Eastern Time ISO string (display only)
    function toET(utcStr) {
        const d = new Date(utcStr + 'Z');
        const et = new Date(d.toLocaleString('en-US', { timeZone: 'America/New_York' }));
        return et.getFullYear() + '-' +
            String(et.getMonth()+1).padStart(2,'0') + '-' +
            String(et.getDate()).padStart(2,'0') + 'T' +
            String(et.getHours()).padStart(2,'0') + ':' +
            String(et.getMinutes()).padStart(2,'0') + ':' +
            String(et.getSeconds()).padStart(2,'0');
    }
    function nowET() {
        const d = new Date();
        const et = new Date(d.toLocaleString('en-US', { timeZone: 'America/New_York' }));
        return et.getFullYear() + '-' +
            String(et.getMonth()+1).padStart(2,'0') + '-' +
            String(et.getDate()).padStart(2,'0') + 'T' +
            String(et.getHours()).padStart(2,'0') + ':' +
            String(et.getMinutes()).padStart(2,'0') + ':' +
            String(et.getSeconds()).padStart(2,'0');
    }

    const basePlotLayout = {
        paper_bgcolor: PLOT_BG,
        plot_bgcolor: PLOT_BG,
        font: { family: 'Space Mono, monospace', color: FONT_COLOR, size: 11 },
        margin: { t: 10, r: 20, b: 40, l: 50 },
        xaxis: { gridcolor: GRID_COLOR, zeroline: false },
        yaxis: { gridcolor: GRID_COLOR, zeroline: false },
    };

    const plotConfig = {
        displayModeBar: false,
        scrollZoom: true,
        responsive: true,
    };

    // -----------------------------------------------------------------------
    // Sync feeds column height to chart panel
    // -----------------------------------------------------------------------
    function syncFeedsHeight() {
        const chart = document.getElementById('chart-panel');
        const feeds = document.getElementById('feeds-col');
        if (chart && feeds && window.innerWidth >= 1024) {
            feeds.style.maxHeight = chart.offsetHeight + 'px';
        } else if (feeds) {
            feeds.style.maxHeight = '';
        }
    }
    window.addEventListener('resize', syncFeedsHeight);

    // -----------------------------------------------------------------------
    // Clock
    // -----------------------------------------------------------------------
    function updateClock() {
        const now = new Date();
        const et = now.toLocaleString('en-US', { timeZone: 'America/New_York', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
        document.getElementById('clock').textContent = et + ' ET';
    }
    setInterval(updateClock, 1000);
    updateClock();

    // Date toggle — Today / Tomorrow
    function getETDate(offsetDays = 0) {
        const d = new Date();
        d.setDate(d.getDate() + offsetDays);
        return d.toLocaleDateString('en-CA', { timeZone: 'America/New_York' });
    }
    let selectedDate = getETDate(0);

    const btnToday = document.getElementById('btn-today');
    const btnTomorrow = document.getElementById('btn-tomorrow');

    function setDateToggle(offset) {
        selectedDate = getETDate(offset);
        if (offset === 0) {
            btnToday.className = 'px-3 py-1 rounded-l border border-slate-600 bg-blue-600 text-white';
            btnTomorrow.className = 'px-3 py-1 rounded-r border border-l-0 border-slate-600 bg-slate-700 text-slate-400 hover:bg-slate-600';
        } else {
            btnToday.className = 'px-3 py-1 rounded-l border border-slate-600 bg-slate-700 text-slate-400 hover:bg-slate-600';
            btnTomorrow.className = 'px-3 py-1 rounded-r border border-l-0 border-slate-600 bg-blue-600 text-white';
        }
        refreshSelectedCity();
    }
    btnToday.addEventListener('click', () => setDateToggle(0));
    btnTomorrow.addEventListener('click', () => setDateToggle(1));

    function getSelectedDate() {
        return selectedDate;
    }

    // -----------------------------------------------------------------------
    // City Selection
    // -----------------------------------------------------------------------
    // NYC-only — no city selector needed

    // Neighbor overlay toggle
    let showNeighbors = false;
    const NEIGHBOR_COLORS = { KLGA: '#a78bfa', KEWR: '#fb923c' }; // violet, orange
    const btnNeighbors = document.getElementById('btn-neighbors');
    btnNeighbors.addEventListener('click', () => {
        showNeighbors = !showNeighbors;
        btnNeighbors.className = showNeighbors
            ? 'px-2 py-0.5 text-[10px] mono rounded border border-blue-500 bg-blue-600 text-white uppercase tracking-wider'
            : 'px-2 py-0.5 text-[10px] mono rounded border border-slate-600 bg-slate-700 text-slate-400 hover:bg-slate-600 uppercase tracking-wider';
        refreshSelectedCity();
    });

    // -----------------------------------------------------------------------
    // API Fetchers
    // -----------------------------------------------------------------------
    async function fetchJSON(url) {
        try {
            const r = await fetch(url);
            return await r.json();
        } catch (e) {
            console.error('Fetch error:', url, e);
            return null;
        }
    }

    // -----------------------------------------------------------------------
    // Ribbon Chart
    // -----------------------------------------------------------------------
    async function renderRibbon(city) {
        const dateParam = getSelectedDate() ? `?date=${getSelectedDate()}` : '';
        const data = await fetchJSON(`/api/forecast-curve/${city}${dateParam}`);
        if (!data || !data.forecasts.length) {
            Plotly.react('ribbon-chart', [], {
                ...basePlotLayout,
                annotations: [{ text: 'No forecast data', showarrow: false, font: { size: 14, color: FONT_COLOR }, xref: 'paper', yref: 'paper', x: 0.5, y: 0.5 }]
            }, plotConfig);
            document.getElementById('ribbon-model-run').textContent = '';
            return;
        }
        const fcstX = data.forecasts.map(p => toET(p.valid_at));
        const fcstY = data.forecasts.map(p => p.temp_f);
        const upperY = data.ribbon.map(p => p.upper_90);
        const lowerY = data.ribbon.map(p => p.lower_90);
        const ribbonX = data.ribbon.map(p => toET(p.valid_at));
        const obsX = data.observations.map(p => toET(p.observed_at));
        const obsY = data.observations.map(p => p.temp_f);

        // Inner 50% CI bounds (z=0.674) — use original UTC keys for lookup
        const fcstMap = {};
        data.forecasts.forEach(p => { fcstMap[p.valid_at] = p.temp_f; });
        const innerUpperY = data.ribbon.map(p => {
            const center = fcstMap[p.valid_at] ?? ((p.upper_90 + p.lower_90) / 2);
            return Math.round((center + 0.674 * p.std) * 10) / 10;
        });
        const innerLowerY = data.ribbon.map(p => {
            const center = fcstMap[p.valid_at] ?? ((p.upper_90 + p.lower_90) / 2);
            return Math.round((center - 0.674 * p.std) * 10) / 10;
        });
        const fcstStdMapUTC = {};
        data.ribbon.forEach(p => { fcstStdMapUTC[p.valid_at] = p.std; });

        // Outer 90% CI — upper bound (invisible anchor for fill)
        const traceUpper = {
            x: ribbonX, y: upperY,
            type: 'scatter', mode: 'lines',
            line: { width: 0 },
            showlegend: false, hoverinfo: 'skip',
        };
        // Outer 90% CI — lower bound (fill to upper)
        const traceLower = {
            x: ribbonX, y: lowerY,
            type: 'scatter', mode: 'lines',
            fill: 'tonexty',
            fillcolor: 'rgba(59,130,246,0.10)',
            line: { width: 0 },
            showlegend: false, hoverinfo: 'skip',
            name: '90% CI',
        };
        // Inner 50% CI — upper bound
        const traceInnerUpper = {
            x: ribbonX, y: innerUpperY,
            type: 'scatter', mode: 'lines',
            line: { width: 0 },
            showlegend: false, hoverinfo: 'skip',
        };
        // Inner 50% CI — lower bound (fill to inner upper)
        const traceInnerLower = {
            x: ribbonX, y: innerLowerY,
            type: 'scatter', mode: 'lines',
            fill: 'tonexty',
            fillcolor: 'rgba(59,130,246,0.22)',
            line: { width: 0 },
            showlegend: false, hoverinfo: 'skip',
            name: '50% CI',
        };
        // Forecast center line with received/released in hover
        const fcstCustom = data.forecasts.map(p => {
            const sigma = fcstStdMapUTC[p.valid_at] ?? null;
            const released = p.model_run ? formatETShort(p.model_run) : '--';
            const received = p.ingested_at ? formatETShort(p.ingested_at) : '--';
            return [sigma, released, received];
        });
        const traceFcst = {
            x: fcstX, y: fcstY,
            type: 'scatter', mode: 'lines',
            line: { color: '#3b82f6', width: 2, dash: 'dot' },
            name: 'HRRR Forecast',
            customdata: fcstCustom,
            hovertemplate: '%{y:.1f}°F (σ=%{customdata[0]:.2f})<br>Released: %{customdata[1]}<br>Received: %{customdata[2]}<extra></extra>',
        };
        // Bias-adjusted HRRR forecast (solid teal)
        const adjX = data.bias_adjusted_forecasts.map(p => toET(p.valid_at));
        const adjY = data.bias_adjusted_forecasts.map(p => p.temp_f);
        const traceAdj = {
            x: adjX, y: adjY,
            type: 'scatter', mode: 'lines',
            line: { color: '#2dd4bf', width: 2.5 },
            name: `Bias-Adj HRRR (${data.adjustment >= 0 ? '+' : ''}${data.adjustment}°F)`,
            hovertemplate: '%{y:.1f}°F<extra>bias-adjusted</extra>',
        };
        // Observed actuals with received/released in hover
        const obsCustom = data.observations.map(p => {
            const released = formatETShort(p.observed_at);
            const received = p.ingested_at ? formatETShort(p.ingested_at) : '--';
            return [released, received];
        });
        const traceObs = {
            x: obsX, y: obsY,
            type: 'scatter', mode: 'lines+markers',
            line: { color: '#f1f5f9', width: 2 },
            marker: { size: 5, color: '#f1f5f9' },
            name: 'Observed',
            customdata: obsCustom,
            hovertemplate: '%{y:.1f}°F<br>Released: %{customdata[0]}<br>Received: %{customdata[1]}<extra></extra>',
        };

        // Settlement high — diamond (NWS CLI) or circle (running obs estimate)
        const isNWS = data.settlement_source === 'nws_cli';
        const traceSettlement = data.observed_high !== null && data.observed_high_at ? {
            x: [toET(data.observed_high_at)],
            y: [data.observed_high],
            type: 'scatter', mode: 'markers',
            marker: {
                size: 10,
                color: '#ef4444',
                symbol: isNWS ? 'diamond' : 'circle',
                line: { color: '#fca5a5', width: 1.5 },
            },
            name: isNWS ? 'NWS Settlement' : 'Running High (est)',
            hovertemplate: (isNWS ? 'NWS Settlement: ' : 'Running High: ') + '%{y:.1f}°F<extra></extra>',
        } : null;

        const settlementShapes = data.observed_high !== null ? [{
            type: 'line',
            x0: 0, x1: 1, xref: 'paper',
            y0: data.observed_high, y1: data.observed_high,
            line: {
                color: 'rgba(239,68,68,0.4)',
                width: 1,
                dash: isNWS ? 'solid' : 'dot',
            },
        }] : [];

        // "Now" vertical line (in ET) — prefer server timestamp, fallback to client
        const nowLine = data.now_utc ? toET(data.now_utc) : nowET();
        const nowShape = {
            type: 'line',
            x0: nowLine, x1: nowLine,
            y0: 0, y1: 1, yref: 'paper',
            line: { color: 'rgba(148,163,184,0.4)', width: 1, dash: 'dash' },
        };

        const selectedDate = getSelectedDate();
        const dayStart = (selectedDate || new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' })) + 'T00:00:00';
        const dayEnd = (selectedDate || new Date().toLocaleDateString('en-CA', { timeZone: 'America/New_York' })) + 'T23:59:59';
        const xaxisConfig = {
            ...basePlotLayout.xaxis,
            type: 'date',
            range: [dayStart, dayEnd],
            dtick: 7200000,           // 2 hours in ms
            tickformat: '%H:%M',
            showgrid: true,
            gridcolor: GRID_COLOR,
        };

        const layout = {
            ...basePlotLayout,
            showlegend: true,
            legend: { x: 0, y: 1.02, orientation: 'h', font: { size: 10 } },
            yaxis: { ...basePlotLayout.yaxis, title: { text: '°F', standoff: 8, font: { size: 10 } } },
            xaxis: xaxisConfig,
            dragmode: 'zoom',
            shapes: [nowShape, ...settlementShapes],
        };

        // Prior model runs as faded ghost lines
        const priorTraces = (data.prior_runs || []).map((run, i) => ({
            x: run.points.map(p => toET(p.valid_at)),
            y: run.points.map(p => p.temp_f),
            type: 'scatter', mode: 'lines',
            line: { color: 'rgba(59,130,246,0.25)', width: 1 },
            name: i === 0 ? 'Prior Runs' : undefined,
            showlegend: i === 0,
            legendgroup: 'prior',
            hovertemplate: '%{y:.1f}°F<extra>' + run.model_run + '</extra>',
        }));

        // 6-hour synoptic max markers (orange triangles)
        const trace6hMax = (data.six_hr_maxes && data.six_hr_maxes.length > 0) ? {
            x: data.six_hr_maxes.map(p => toET(p.observed_at)),
            y: data.six_hr_maxes.map(p => p.temp_f),
            type: 'scatter', mode: 'markers',
            marker: { size: 10, symbol: 'triangle-left', color: '#f1f5f9' },
            name: '6hr High',
            hovertemplate: '%{y:.1f}°F<extra>6-hour max (peaked before this time)</extra>',
        } : null;

        // Neighbor station observation traces (toggled)
        const neighborTraces = [];
        if (showNeighbors && data.neighbor_obs) {
            for (const [stnId, pts] of Object.entries(data.neighbor_obs)) {
                if (pts.length === 0) continue;
                const color = NEIGHBOR_COLORS[stnId] || '#9ca3af';
                const nbrCustom = pts.map(p => {
                    const released = formatETShort(p.observed_at);
                    const received = p.ingested_at ? formatETShort(p.ingested_at) : '--';
                    return [released, received];
                });
                neighborTraces.push({
                    x: pts.map(p => toET(p.observed_at)),
                    y: pts.map(p => p.temp_f),
                    type: 'scatter', mode: 'lines+markers',
                    line: { color, width: 1.5, dash: 'dot' },
                    marker: { size: 3, color },
                    name: stnId,
                    customdata: nbrCustom,
                    hovertemplate: '%{y:.1f}°F<br>Released: %{customdata[0]}<br>Received: %{customdata[1]}<extra>' + stnId + '</extra>',
                });
            }
        }

        const allTraces = [...priorTraces, traceFcst, traceObs, ...neighborTraces];
        if (traceSettlement) allTraces.push(traceSettlement);
        if (trace6hMax) allTraces.push(trace6hMax);

        Plotly.react('ribbon-chart', allTraces, layout, plotConfig);
        requestAnimationFrame(syncFeedsHeight);
        document.getElementById('ribbon-model-run').textContent = selectedCity;
    }

    // -----------------------------------------------------------------------
    // Market Intelligence
    // -----------------------------------------------------------------------
    async function refreshMarket(city) {
        const dateParam = getSelectedDate() ? `?date=${getSelectedDate()}` : '';
        const data = await fetchJSON(`/api/market/${city}${dateParam}`);
        const pending = document.getElementById('market-pending');
        const table = document.getElementById('market-table');
        const body = document.getElementById('market-body');
        const status = document.getElementById('market-status');

        if (!data || !data.available) {
            pending.classList.remove('hidden');
            table.classList.add('hidden');
            status.textContent = data?.message || 'Market data pending';
            return;
        }

        pending.classList.add('hidden');
        table.classList.remove('hidden');

        let gapCount = 0;
        body.innerHTML = data.comparisons.map(c => {
            // Alpha gap: model is 15%+ higher relative to market mid
            const isAlphaGap = false;
            const rowClass = '';
            const edgeColor = c.edge > 0.05 ? 'text-emerald-400' : c.edge < -0.05 ? 'text-red-400' : 'text-slate-400';
            const edgeStr = c.edge !== null ? `${(c.edge * 100).toFixed(1)}pp` : '--';
            const signalLabel = '';
            const signalColor = 'text-slate-600';

            return `<tr class="${rowClass} border-b border-slate-800/50">
                <td class="py-2 pr-4">${c.bracket}°F <span class="${signalColor} text-xs ml-1">${signalLabel}</span></td>
                <td class="py-2 pr-4 text-slate-600">--</td>
                <td class="py-2 pr-4">${c.market_mid !== null ? (c.market_mid * 100).toFixed(1) + '%' : '--'}</td>
                <td class="py-2 pr-4 text-slate-600">--</td>
                <td class="py-2 pr-4 text-slate-400">${c.yes_bid ?? '--'}</td>
                <td class="py-2 text-slate-400">${c.yes_ask ?? '--'}</td>
            </tr>`;
        }).join('');

        const gapStr = gapCount > 0 ? ` · ${gapCount} alpha gap${gapCount > 1 ? 's' : ''}` : '';
        status.textContent = `${data.comparisons.length} brackets${gapStr}`;
    }

    // -----------------------------------------------------------------------
    // Observation Feed
    // -----------------------------------------------------------------------
    function formatETShort(utcStr) {
        if (!utcStr) return '--';
        const d = new Date(utcStr + 'Z');
        return d.toLocaleString('en-US', { timeZone: 'America/New_York', hour: '2-digit', minute: '2-digit', hour12: false });
    }

    let prevObsCount = 0;

    async function refreshObsFeed(city) {
        const dateParam = getSelectedDate() ? `?date=${getSelectedDate()}` : '';
        const data = await fetchJSON(`/api/observations/${city}${dateParam}`);
        const body = document.getElementById('obs-body');
        const status = document.getElementById('obs-status');

        if (!data || !data.observations || data.observations.length === 0) {
            body.innerHTML = '<tr><td colspan="5" class="py-4 text-center text-slate-500">No observations</td></tr>';
            status.textContent = '';
            prevObsCount = 0;
            return;
        }

        const newCount = data.observations.length;
        const hasNew = newCount > prevObsCount && prevObsCount > 0;
        const newRows = hasNew ? newCount - prevObsCount : 0;
        prevObsCount = newCount;

        body.innerHTML = data.observations.map((o, i) => {
            const released = formatETShort(o.observed_at);
            const received = o.ingested_at ? formatETShort(o.ingested_at) : '--';
            const obsWindow = o.obs_window || 'snapshot';
            const flashClass = (hasNew && i < newRows) ? ' flash-new' : '';
            const highClass = o.is_new_high ? ' bg-emerald-900/40' : '';
            const sourceColor = o.source.includes('SPECI') ? 'text-yellow-400'
                : o.source === 'NWS CLI' ? 'text-red-400'
                : o.source.startsWith('AWC') ? 'text-teal-400'
                : 'text-slate-400';
            const obsColor = obsWindow === 'prior 6hrs' ? 'text-orange-400'
                : obsWindow === 'daily high' ? 'text-red-400'
                : 'text-slate-500';
            const tempColor = o.is_new_high ? 'text-emerald-400 font-bold' : 'text-slate-200';
            return `<tr class="border-b border-slate-800/30${flashClass}${highClass}">
                <td class="py-1 pr-2 text-slate-500">${received}</td>
                <td class="py-1 pr-2 text-slate-300">${released}</td>
                <td class="py-1 pr-2 ${obsColor}">${obsWindow}</td>
                <td class="py-1 pr-2 ${sourceColor}">${o.source}</td>
                <td class="py-1 text-right ${tempColor}">${o.temp_f.toFixed(1)}°</td>
            </tr>`;
        }).join('');

        const highStr = data.running_high !== null
            ? ` · high ${data.running_high.toFixed(1)}°F`
            : '';
        status.textContent = `${data.observations.length} obs${highStr}`;
    }

    // -----------------------------------------------------------------------
    // Forecast Feed
    // -----------------------------------------------------------------------
    async function refreshFcstFeed(city) {
        const dateParam = getSelectedDate() ? `?date=${getSelectedDate()}` : '';
        const data = await fetchJSON(`/api/forecast-points/${city}${dateParam}`);
        const body = document.getElementById('fcst-body');
        const status = document.getElementById('fcst-status');

        if (!data || !data.runs || data.runs.length === 0) {
            body.innerHTML = '<tr><td colspan="6" class="py-4 text-center text-slate-500">No forecast runs</td></tr>';
            status.textContent = '';
            return;
        }

        body.innerHTML = data.runs.map(r => {
            const runET = formatETShort(r.model_run);
            const received = r.ingested_at ? formatETShort(r.ingested_at) : '--';
            const highAt = formatETShort(r.high_valid_at);

            // Format time delta
            let timeDelta = '';
            let timeDeltaColor = 'text-slate-600';
            if (r.time_change_mins !== null) {
                const hrs = Math.floor(Math.abs(r.time_change_mins) / 60);
                const mins = Math.abs(r.time_change_mins) % 60;
                const sign = r.time_change_mins > 0 ? '+' : r.time_change_mins < 0 ? '-' : '';
                timeDelta = hrs > 0 ? `${sign}${hrs}h${mins > 0 ? mins + 'm' : ''}` : `${sign}${mins}m`;
                if (r.time_change_mins === 0) timeDelta = '—';
                timeDeltaColor = 'text-slate-400';
            }

            // Format temp delta
            let tempDelta = '';
            let tempDeltaColor = 'text-slate-600';
            if (r.temp_change !== null) {
                const sign = r.temp_change > 0 ? '+' : '';
                tempDelta = `${sign}${r.temp_change.toFixed(1)}°`;
                if (r.temp_change === 0) { tempDelta = '—'; }
                else if (r.temp_change > 0) tempDeltaColor = 'text-red-400';
                else tempDeltaColor = 'text-blue-400';
            }

            return `<tr class="border-b border-slate-800/30">
                <td class="py-1 pr-2 text-slate-400">${runET}z</td>
                <td class="py-1 pr-2 text-slate-500">${received}</td>
                <td class="py-1 pr-2 text-slate-300">${highAt}</td>
                <td class="py-1 pr-2 ${timeDeltaColor}">${timeDelta}</td>
                <td class="py-1 pr-2 text-right text-blue-400">${r.high_temp_f.toFixed(1)}°</td>
                <td class="py-1 text-right ${tempDeltaColor}">${tempDelta}</td>
            </tr>`;
        }).join('');

        const latestStr = data.latest_run
            ? `Latest ${formatETShort(data.latest_run)}z` : 'No runs';
        const highStr = data.forecast_high !== null
            ? ` · high ${data.forecast_high.toFixed(1)}°F` : '';
        status.textContent = `${latestStr}${highStr}`;
    }

    // -----------------------------------------------------------------------
    // Orchestration
    // -----------------------------------------------------------------------
    let countdown = 60;

    async function refreshSelectedCity() {
        await Promise.all([
            renderRibbon(selectedCity),
            refreshObsFeed(selectedCity),
            refreshFcstFeed(selectedCity),
            refreshMarket(selectedCity),
        ]);
        // Update last-updated timestamp
        const now = new Date();
        const ts = now.toLocaleString('en-US', { timeZone: 'America/New_York', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
        document.getElementById('last-updated').textContent = 'upd ' + ts;
        countdown = 60;
    }

    async function refreshAll() {
        await refreshSelectedCity();
    }

    // Countdown timer — ticks every second
    setInterval(() => {
        countdown = Math.max(0, countdown - 1);
        document.getElementById('refresh-countdown').textContent = countdown + 's';
    }, 1000);

    // Initial load
    refreshAll();

    // Auto-refresh every 60 seconds
    setInterval(refreshAll, 60000);
    </script>
</body>
</html>
