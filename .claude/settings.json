{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Edit(src/**)",
      "Edit(tests/**)",
      "Edit(scripts/**)",
      "Bash(npm *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(git *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(grep *)",
      "Bash(mkdir *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Edit(.env*)"
    ]
  }
}
